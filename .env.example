# Erwin-Bot Configuration Template
# Copy this file to .env and fill in the values

PREFIX=-
BOT_NAME=Erwin-Bot
PORT=3000

# Owners (format: number without +)
OWNER_NUMBER=
OWNER_IDS=

# AI (Groq API Key Required)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=

# Third Party Services (Optional)
OPENWEATHER_API_KEY=
OMDB_API_KEY=
NEWSAPI_KEY=

# Render Persistence & Anti-Sleep (Optional)
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_URL=
