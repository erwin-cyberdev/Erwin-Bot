# --- CONFIGURATION PRINCIPALE ---
PREFIX=!
BOT_NAME=Erwin-Bot
PORT=3000
NODE_ENV=production

# --- PROPRIÉTAIRES ---
# Format: numéro sans le +, séparés par des virgules
OWNER_NUMBER=237674151474
OWNER_IDS=237674151474,237679137132

# --- INTELLIGENCE ARTIFICIELLE ---
# Requis pour le répondeur intelligent et les commandes IA
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...

# --- PERSISTANCE RENDER (OBLIGATOIRE POUR V2) ---
# 1. Allez dans Render Dashboard > Account Settings > API Keys > Create API Key
RENDER_API_KEY=rnd_...
# 2. L'ID est dans l'URL de votre service : https://dashboard.render.com/web/srv-xxxxxxx
RENDER_SERVICE_ID=srv-xxxxxxx
# 3. L'URL publique de votre bot pour l'auto-ping
RENDER_URL=https://votre-bot.onrender.com

# --- AUTO GÉRÉ PAR LE BOT (Ne pas toucher) ---
# Le bot remplira cette variable automatiquement pour sauvegarder la session
SESSION_DATA=
