# Erwin-Bot Configuration
# Copie ce fichier en .env et remplis les valeurs

# Bot Settings
PREFIX=-
BOT_NAME=Erwin-Bot
PORT=3000

# Owners (format: numéros séparés par des virgules, avec indicatif pays)
OWNER_NUMBER=237674151474
OWNER_IDS=237674151474,237679137132

# IA (Groq - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Services tiers
OPENWEATHER_API_KEY=your_openweather_key_here
OMDB_API_KEY=your_omdb_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Persistance Render (Optional - seulement si déployé sur Render)
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_URL=

# Session WhatsApp (Optional - pour persistence)
# SESSION_DATA=
